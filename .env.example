# PostgreSQL password used by both services in docker-compose.yml
POSTGRES_PASSWORD=change_me

# ThingsBoard device access token. Create a device first and paste its token here.
TB_DEVICE_TOKEN=PASTE_DEVICE_ACCESS_TOKEN

# Emulator settings
TB_HOST=localhost
TB_MQTT_PORT=1883
TB_DEVICE_NAME=PV-01
SEND_INTERVAL_SEC=2
FILTER_GROWTH_PA_PER_MIN=5
